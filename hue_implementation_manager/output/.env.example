# Postgres connection string (Neon or any Postgres 14+ instance). Neon's pooled connection
# string works fine; include ?sslmode=require if your provider needs it.
DATABASE_URL=postgres://user:password@host/dbname

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated list of frontend origins allowed to call this API with credentials.
# Defaults to the local Vite dev server (http://localhost:5173) when unset.
# In production, set this to the real domain(s), e.g.:
#   CORS_ORIGIN=https://39n.co,https://www.39n.co
CORS_ORIGIN=http://localhost:5173

# Must be "production" in any real deployment -- this is what makes the session cookie
# `secure` (HTTPS-only). Leave unset for local development.
NODE_ENV=

# Port the Express API listens on. Defaults to 3000 if unset.
PORT=3000
